# Public configuration only. Never put a private key, keystore password or API secret in any .env file.
# Copy to .env for local development. Production builds also read .env.production (committed).

# Which Arc network the app talks to: "mainnet" or "testnet".
# Production (Vercel): mainnet. Local development default: testnet, so you do not spend real USDC.
VITE_LATCH_NETWORK=mainnet

# Arc Mainnet (chain ID 5042): the independent mainnet deployment of Latch.
# Explorer: https://explorer.arc.io/address/0xd09EAC2f4eF49A5E918bB49884189c37793a7CC2
VITE_LATCH_ADDRESS_MAINNET=0xd09EAC2f4eF49A5E918bB49884189c37793a7CC2
VITE_LATCH_DEPLOY_BLOCK_MAINNET=29071512

# Arc Testnet (chain ID 5042002): optional development deployment.
# Explorer: https://explorer.testnet.arc.io/address/0xdb90ccaee5b1c63139de9d01fd93b8c0c3665a3b
VITE_LATCH_ADDRESS_TESTNET=0xdb90ccaee5b1c63139de9d01fd93b8c0c3665a3b
VITE_LATCH_DEPLOY_BLOCK_TESTNET=70172256
