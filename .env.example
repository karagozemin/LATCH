# Which Arc network the app talks to: "testnet" (default) or "mainnet".
# Mainnet moves real USDC. Only switch after you have deployed and reviewed your own contract.
VITE_LATCH_NETWORK=testnet

# Arc Testnet (chain ID 5042002) deployment. All values here are public.
VITE_LATCH_ADDRESS_TESTNET=
VITE_LATCH_DEPLOY_BLOCK_TESTNET=

# Arc Mainnet (chain ID 5042) deployment. Leave empty until you have deployed Latch yourself.
# Never reuse the testnet address here: the app refuses it.
VITE_LATCH_ADDRESS_MAINNET=
VITE_LATCH_DEPLOY_BLOCK_MAINNET=
