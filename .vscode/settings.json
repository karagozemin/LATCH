{
  "explorer.compactFolders": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "bun.lock, .bun-version, tsconfig.json, vite.config.ts, vercel.json, .oxlintrc.json, index.html",
    "foundry.toml": ".foundry-version",
    ".env.example": ".env.production",
    "README.md": "AGENTS.md, LICENSE"
  },
  "files.exclude": {
    "**/node_modules": true,
    "dist": true,
    "broadcast": true,
    "lib": true,
    "contracts/out": true,
    "contracts/cache": true,
    "contracts/broadcast": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "dist": true,
    "broadcast": true,
    "lib": true,
    "contracts/out": true,
    "contracts/cache": true,
    "contracts/broadcast": true
  }
}
