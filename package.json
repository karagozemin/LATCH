{
  "name": "latch",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --prefix sites/latch-demo",
    "build:client": "npm run build --workspace latch-client && node scripts/sync-site-client.mjs",
    "generate:client": "node scripts/generate-client.mjs",
    "rehearse:replay": "node scripts/rehearse-replay.mjs",
    "sync:testnet-config": "node scripts/sync-testnet-config.mjs",
    "build:site": "npm run check --prefix sites/latch-demo && npm run build --prefix sites/latch-demo",
    "testnet:bootstrap": "node scripts/testnet/bootstrap.mjs",
    "rehearse:experience": "node scripts/rehearse-experience.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.2.1"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
